# Copy to .env.local for development. Never commit real values.

# PostgreSQL connection (Systalink managed database). Leave empty locally to use the embedded PGlite database.
DATABASE_URL=
# "require" (verify TLS certificate), "no-verify" (encrypt only), or empty (no TLS, private network)
DATABASE_SSL=

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Enables automatic FR <-> EN translation of new posts. Without it, posts are shown in their original language.
ANTHROPIC_API_KEY=
# Optional override of the translation model (default: claude-opus-5-5)
TRANSLATION_MODEL=

# Set to "off" to hide the demo-account hint on the login page
DEMO_ACCOUNT_HINT=
